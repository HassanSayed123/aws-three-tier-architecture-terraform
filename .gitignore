# Local .terraform directories
**/.terraform/
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude sensitive variables
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH Keys or sensitive files
*.pem
*.key